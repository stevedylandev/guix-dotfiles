# Darkmatter -- KDE color scheme
# https://darkmattertheme.com
# Palette matches sway, qtile, kitty, rofi, librewolf, and emacs:
#   bg      18,17,19    #121113     teal    95,135,135  #5f8787
#   sidebar 23,22,24    #171618     cream   251,203,151 #fbcb97
#   base    28,27,29    #1c1b1d     orange  231,138,83  #e78a53
#   hover   34,34,34    #222222     red     231,83,83   #e75353
#   grey    51,51,51    #333333     dim     136,136,136 #888888
#   subtle  193,193,193 #c1c1c1     fg      255,255,255 #ffffff
# Also used as the Plasma desktop theme's `colors` file (see home.scm).

[ColorEffects:Disabled]
Color=18,17,19
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

