# ~/.config/sway/config -- Darkmatter
# Palette matches the Darkmatter GTK theme, kitty, and emacs themes.
# Bindings follow the old cwmrc where sway has an equivalent.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term kitty
set $menu rofi -show drun

font pango:BerkeleyMono Nerd Font Mono 13

output * bg $HOME/wallpapers/assets/temple.png fill
output HDMI-A-1 scale 1.20

default_border pixel 2
default_floating_border pixel 2
gaps inner 12
gaps outer 0
focus_follows_mouse no

# Darkmatter
# class                 border  bg      text    indicator child_border
client.focused          #fbcb97 #121113 #c1c1c1 #e78a53   #fbcb97
client.focused_inactive #333333 #121113 #c1c1c1 #333333   #333333
client.unfocused        #333333 #121113 #888888 #333333   #333333
client.urgent           #e75353 #121113 #c1c1c1 #e75353   #e75353

# Launchers
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+b exec librewolf --scale=1.25

# Window actions
bindsym $mod+w kill
bindsym $mod+f fullscreen toggle
bindsym $mod+s sticky toggle
bindsym $mod+t splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split
bindsym $mod+Shift+t floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent
bindsym $mod+n move scratchpad
bindsym $mod+Shift+n scratchpad show

# Focus and move with vim keys
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# Resize (Super+Control) with vim keys
bindsym $mod+Control+$left resize shrink width 40px
bindsym $mod+Control+$down resize grow height 40px
bindsym $mod+Control+$up resize shrink height 40px
bindsym $mod+Control+$right resize grow width 40px

# Workspaces: Super+N shows workspace N, Super+Shift+N sends the window there
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+grave workspace back_and_forth
bindsym $mod+Tab workspace next_on_output
bindsym $mod+Shift+Tab workspace prev_on_output

# Mouse: Super+left drag moves, Super+right drag resizes floating windows
floating_modifier $mod normal

# Window manager
bindsym $mod+Shift+Escape reload
bindsym $mod+Shift+q exec swaymsg exit

bar {
    position top
    font pango:BerkeleyMono Nerd Font Mono 13
    status_command while date +'%Y-%m-%d %H:%M'; do sleep 30; done
    colors {
        background #121113
        statusline #c1c1c1
        separator  #333333
        # class            border  bg      text
        focused_workspace  #e78a53 #e78a53 #121113
        active_workspace   #333333 #333333 #c1c1c1
        inactive_workspace #121113 #121113 #888888
        urgent_workspace   #e75353 #e75353 #121113
    }
}

# Pin apps to a workspace (see swaymsg -t get_tree for app_id)
# assign [app_id="librewolf"] workspace number 2
