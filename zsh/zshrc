# Fuzzy-find a file and open in nvim
nvimf() {
  local file
  file=$(fd --type f --hidden --exclude .git | fzf --preview "bat --color=always {}")
  if [ -z "$file" ]; then
    echo "No file selected"
  else
    nvim "$file"
  fi
}

