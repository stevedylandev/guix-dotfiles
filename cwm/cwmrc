# ~/.cwmrc -- Darkmatter
# Palette matches the Darkmatter GTK theme, kitty, and emacs themes.
# Modifier prefixes: C=Control M=Alt S=Shift 4=Super. Super is Mod4, so
# bindings are written "4-", not "M-". Combine modifiers before one dash: "4S-q".

fontname "BerkeleyMono Nerd Font Mono:pixelsize=16"
borderwidth 0
gap 12 12 12 12
snapdist 8
sticky yes

# Darkmatter
color activeborder   "#5f8787"
color inactiveborder "#333333"
color urgencyborder  "#e75353"
color groupborder    "#fbcb97"
color ungroupborder  "#e78a53"
# Menus: background, text, selected-item highlight and its text
color menubg  "#121113"
color font    "#c1c1c1"
color menufg  "#e78a53"
color selfont "#121113"

# Applications (shown in the M-? application menu)
command term  kitty
command emacs emacs
command librewolf librewolf
command btop  "kitty btop"

# Start with a clean slate; only the bindings below are active
unbind-key  all
unbind-mouse all

# Launchers
bind-key 4-Return terminal
bind-key 4-d      "rofi -show drun"
bind-key 4-space  menu-exec
bind-key 4-slash  menu-cmd
bind-key 4-Tab    menu-window
bind-key 4-b      "librewolf"

# Window actions
bind-key 4-w      window-close
bind-key 4-f      window-fullscreen
bind-key 4-m      window-maximize
bind-key 4S-m     window-vmaximize
bind-key 4-n      window-hide
bind-key 4-s      window-stick
bind-key 4-r      window-raise
bind-key 4S-r     window-lower
bind-key 4-t      window-htile
bind-key 4-v      window-vtile

# Focus
bind-key 4-j      window-cycle
bind-key 4-k      window-rcycle
bind-key M-Tab    window-cycle
bind-key MS-Tab   window-rcycle

# Move (Super+Shift) and resize (Super+Control) with vim keys
bind-key 4S-h     window-move-left-big
bind-key 4S-j     window-move-down-big
bind-key 4S-k     window-move-up-big
bind-key 4S-l     window-move-right-big
bind-key 4C-h     window-resize-left-big
bind-key 4C-j     window-resize-down-big
bind-key 4C-k     window-resize-up-big
bind-key 4C-l     window-resize-right-big

# Snap to screen edges
bind-key 4M-h     window-snap-left
bind-key 4M-j     window-snap-down
bind-key 4M-k     window-snap-up
bind-key 4M-l     window-snap-right

# Groups: Super+N shows only group N, Super+Shift+N sends the window there,
# Super+Control+N toggles group N on top of what is shown
bind-key 4-1 group-only-1
bind-key 4-2 group-only-2
bind-key 4-3 group-only-3
bind-key 4-4 group-only-4
bind-key 4-5 group-only-5
bind-key 4-6 group-only-6
bind-key 4-7 group-only-7
bind-key 4-8 group-only-8
bind-key 4-9 group-only-9
bind-key 4S-1 window-movetogroup-1
bind-key 4S-2 window-movetogroup-2
bind-key 4S-3 window-movetogroup-3
bind-key 4S-4 window-movetogroup-4
bind-key 4S-5 window-movetogroup-5
bind-key 4S-6 window-movetogroup-6
bind-key 4S-7 window-movetogroup-7
bind-key 4S-8 window-movetogroup-8
bind-key 4S-9 window-movetogroup-9
bind-key 4C-1 group-toggle-1
bind-key 4C-2 group-toggle-2
bind-key 4C-3 group-toggle-3
bind-key 4C-4 group-toggle-4
bind-key 4C-5 group-toggle-5
bind-key 4C-6 group-toggle-6
bind-key 4C-7 group-toggle-7
bind-key 4C-8 group-toggle-8
bind-key 4C-9 group-toggle-9
bind-key 4-0     group-toggle-all
bind-key 4-grave group-last
bind-key 4-g     window-group

# Window manager
bind-key 4S-Escape restart
bind-key 4S-q     quit

# Mouse: Super+drag to move/resize, Super+middle to lower
bind-mouse 4-1 window-move
bind-mouse 4-3 window-resize
bind-mouse 4-2 window-lower
# Clicks on the empty desktop
bind-mouse 1 menu-window
bind-mouse 3 menu-cmd

# Pin apps to a group: autogroup <group> "instance,class" (see xprop WM_CLASS)
# autogroup 2 "librewolf"
