#!/bin/sh
# ~/.xsession -- run by Guix's xinitrc wrapper. SLiM passes no session
# here, so the window manager is started by name below.

# Keep session output so crashes can be debugged
exec > "$HOME/.xsession-errors" 2>&1
set -x

feh --no-fehbg --bg-fill "$HOME/wallpapers/assets/temple.png" &

exec cwm
